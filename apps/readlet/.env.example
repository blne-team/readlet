# Copy to apps/readlet/.env.local for Next.js and Docker Compose.
# Cloudflare Worker deployments need these as Worker runtime variables too.
# CLI publishing credentials deliberately do not belong here: copy the root
# .env.sync.example to .env.sync and load it only for the sync command.
NEXT_TELEMETRY_DISABLED=1
# Day of month when this Cloudflare account's billing period begins.
READLET_R2_BILLING_DAY=1
# Development only: prefer `pnpm dev:no-auth` instead of persisting this here.
# READLET_DEV_AUTH_BYPASS=1
READLET_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
READLET_ACCESS_AUD=your-access-application-audience-tag
READLET_BOOTSTRAP_MANAGER_EMAIL=you@example.com
