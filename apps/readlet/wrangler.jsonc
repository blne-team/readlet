{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "readlet",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "keep_vars": true,
  "vars": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "READLET_INSTALLATION": "1",
    "READLET_R2_BILLING_DAY": "1"
  },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  },
  // BOOKS is attached by Readlet's first-run setup. Preserve that binding when
  // later Git builds upload a new version whose source config cannot name the
  // account-specific bucket.
  "unsafe": {
    "metadata": {
      "keep_bindings": [
        "plain_text",
        "json",
        "secret_text",
        "secret_key",
        "r2_bucket"
      ]
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "R2_USAGE",
        "class_name": "R2UsageLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["R2UsageLedger"]
    }
  ],
  "ratelimits": [
    {
      "name": "R2_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
