# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# turborepo
.turbo/

# built packages
packages/*/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!**/.env.example
.dev.vars*
.wrangler-auth

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare
.open-next/
.wrangler/

# the sync tool's directories, as configured in readlet.config.json
/books/
/library/

# where the filesystem provider publishes to, in the documented setup
/shelf-data/

# pdf.js's runtime files, copied out of pdfjs-dist by the app's `assets` task
# rather than vendored — see apps/readlet/scripts/pdfjs-assets.ts
/apps/readlet/public/pdfjs/
